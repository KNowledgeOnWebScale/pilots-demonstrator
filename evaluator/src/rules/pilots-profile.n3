@prefix : <http://example.org/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix report: <https://w3id.org/force/compliance-report#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pilotsProfile: <https://pilots-project.be/odrlProfile/> .

#######################################################################################################################
# ODRL PILOTS profile: left operand pilotsProfile:shape
#
# Added to the first reasoning step of the ODRL Evaluator rules.
# Input: one sh:ValidationReport per shape, linked to that shape with :validatedShape (see src/ShapeValidation.ts).
#
# These rules only resolve the left operand value, as is done for the ODRL left operands (constraints.n3):
# the value is the shape when the State of the World conforms to it, and "" (no value) otherwise.
# The operator rules of the ODRL Evaluator then decide the satisfaction state (e.g. odrl:eq with the shape as right operand).

# Left operand value: the shape, when the State of the World conforms to it
{
    ?premiseReport report:constraint ?constraint .
    ?constraint odrl:leftOperand pilotsProfile:shape ;
        odrl:rightOperand ?shape .

    ?validationReport :validatedShape ?shape ;
        sh:conforms true .
} => {
    ?premiseReport pilotsProfile:shaclReport ?validationReport .
    ?premiseReport report:constraintLeftOperand ?shape .
} .

# Left operand value: none, when the State of the World does not conform to the shape
{
    ?premiseReport report:constraint ?constraint .
    ?constraint odrl:leftOperand pilotsProfile:shape ;
        odrl:rightOperand ?shape .

    ?validationReport :validatedShape ?shape ;
        sh:conforms false .
} => {
    ?premiseReport pilotsProfile:shaclReport ?validationReport .
    ?premiseReport report:constraintLeftOperand "" .
} .


#######################################################################################################################
# ODRL PILOTS profile: role-based assignee (odrl:refinement on the assignee with left operand pilotsProfile:role)
#
# Added to the first reasoning step of the ODRL Evaluator rules.
# A refined assignee is role-based: the requesting party belongs to it iff it satisfies all refinements,
# e.g. when the role it supplies in the evaluation request equals the right operand.
# Membership of a fixed party collection (odrl:partOf) is not required.
#
# Expected in the evaluation request:
#   ?request sotw:requestParameter [ sotw:describesFeature pilots:actorRole ; sotw:value dpv:ServiceConsumer ] .
 
@prefix sotw: <https://w3id.org/force/sotw#> .
@prefix pilots: <https://pilots-project.be/ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
 
# Constraint report for each refinement of the assignee, as premise report of the party report
{
    ?ruleReport report:rule ?rule ;
        report:premiseReport ?partyReport .
    ?partyReport a report:PartyReport .
    ?rule odrl:assignee ?party .
    ?party odrl:refinement ?constraint .
 
    ( ?party ?constraint ) :getUUID ?constraintReport .
} => {
    ?partyReport report:premiseReport ?constraintReport .
    ?constraintReport a report:ConstraintReport ;
        report:constraint ?constraint .
} .
 
# Left operand pilotsProfile:role: the role supplied in the evaluation request.
# The evaluation request is found by walking up the premise reports (constraint report -> party report -> rule report).
{
    ?premiseReport report:constraint ?constraint ;
        :evaluationRequest ?evaluationRequest .
    ?constraint odrl:leftOperand pilotsProfile:role .
 
    ?evaluationRequest sotw:requestParameter ?requestParam .
    ?requestParam sotw:describesFeature pilots:actorRole ;
        sotw:value ?role .
} => {
    ?premiseReport report:constraintLeftOperand ?role .
} .
 
# Left operand pilotsProfile:role: none, when the evaluation request supplies no role
{
    ?premiseReport report:constraint ?constraint ;
        :evaluationRequest ?evaluationRequest .
    ?constraint odrl:leftOperand pilotsProfile:role .
 
    (
        ?template
        {
            ?evaluationRequest sotw:requestParameter ?requestParam .
            ?requestParam sotw:describesFeature pilots:actorRole .
        }
        ?L
    ) log:collectAllIn ?SCOPE .
    ?L list:length 0 .
} => {
    ?premiseReport report:constraintLeftOperand "" .
} .
 
# Party report of a refined assignee: satisfied iff all of its refinement constraint reports are satisfied.
# The refinements are collected from the policy (input, so safe to collect in this step);
# their satisfaction is then checked positively, one by one (:refinementsSatisfied).
{
    ?ruleReport report:rule ?rule ;
        report:premiseReport ?partyReport .
    ?partyReport a report:PartyReport .
    ?rule odrl:assignee ?party .
    ?party odrl:refinement _:anyRefinement .
 
    ( ?constraint { ?party odrl:refinement ?constraint } ?refinements ) log:collectAllIn ?SCOPE .
    ( ?partyReport ?refinements ) :refinementsSatisfied true .
} => {
    ?partyReport report:satisfactionState report:Satisfied .
} .
 
{ ( ?partyReport () ) :refinementsSatisfied true } <= { } .
{ ( ?partyReport ?refinements ) :refinementsSatisfied true } <= {
    ?refinements rdf:first ?constraint ;
        rdf:rest ?rest .
    ?partyReport report:premiseReport ?constraintReport .
    ?constraintReport report:constraint ?constraint ;
        report:satisfactionState report:Satisfied .
    ( ?partyReport ?rest ) :refinementsSatisfied true .
} .
 
